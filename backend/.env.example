# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=syncle

# Bot
BOT_TOKEN=123456:your-telegram-bot-token

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# LLM (OpenAI-compatible gateway, e.g. ProxyAPI: https://api.proxyapi.ru/openai/v1)
# Leave LLM_API_KEY/LLM_MODEL empty to disable LLM (reports fall back to deterministic diff)
# ProxyAPI serves OpenAI models only — e.g. gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=
LLM_TIMEOUT=30

# Redis (local instance; Taskiq broker and job state)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=false

# Background jobs: inline = fast awaited path (default),
# taskiq = submit to the Taskiq/Redis worker (run: uv run taskiq worker src.worker.app:broker)
JOBS_MODE=inline
# Bot poll interval over active background jobs (taskiq mode), seconds
JOBS_POLL_INTERVAL=2

# Price parsing (Playwright; docs/adr/ADR-004)
# PRICE_ENABLED=false falls back to "цена недоступна"
PRICE_ENABLED=true
# WB antibot rejects headless browsers; keep false unless a display/Xvfb is available
PRICE_HEADLESS=false
PRICE_TIMEOUT=45
# Optional residential/mobile proxy and an HTTP endpoint that rotates its IP
PROXY_URL=
PROXY_ROTATE_URL=
# optimal_price = competitor price minus this percent
OPTIMAL_PRICE_UNDERCUT_PCT=3