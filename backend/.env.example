# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=syncle

# Bot
BOT_TOKEN=123456:your-telegram-bot-token

# LLM (OpenAI-compatible gateway, e.g. ProxyAPI: https://api.proxyapi.ru/openai/v1)
# Leave LLM_API_KEY/LLM_MODEL empty to disable LLM (reports fall back to deterministic diff)
# ProxyAPI serves OpenAI models only — e.g. gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=
LLM_TIMEOUT=30